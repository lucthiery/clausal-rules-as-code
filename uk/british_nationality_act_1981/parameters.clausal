% parameters.clausal -- machine-readable provenance for this domain's legally-sourced
% parameter VALUES. Purely additive: the value facts stay in the logic modules; these rows only
% REFERENCE them by functor name. Load-on-demand -- NOT imported by the logic modules.
%
% Owns parameter_source/2: parameter_source(<functor>, [label-'...', ref-'...', verbatim-'...', units-[...]]).
% The verbatim states the value in the source's own words.

:- module(parameters, [parameter_source/2]).

parameter_source(commencement_date, [
    label-'S.I. 1982/933 art. 2 — the British Nationality Act 1981 comes into force on 1 January 1983',
    ref-'https://www.legislation.gov.uk/uksi/1982/933/made',
    verbatim-'The British Nationality Act 1981, except sections 49 and 53 which came into force on the passing of the Act, shall come into force on 1st January 1983.',
    units-['uksi-1982-933#article-2']
]).

:- end_module(parameters).
