% citations.clausal -- machine-readable citation registry for uk/british_nationality_act_1981.
%
% Every record names units of the pinned British Nationality Act 1981 (c. 61) AS ENACTED
% (or of the Commencement Order 1982, S.I. 1982/933) under sources/, and every `verbatim`
% is copied from the first unit it names (T5 checks it). Units this domain does not
% implement are deferred in manifest.yaml `deferred_set`.
%
% Owns implements/1 (the in-clause provenance marker) and citation/2 (the lookup).
%
% Clausal Prolog record form:
%   citation(Key, [label-'...', ref-'...', verbatim-'...', units-['...', ...]]).
% The citation keys are atoms: they need no export entry in a .clausal module.

:- module(citations, [
    implements/1,
    citation/2
]).

% implements/1 -- the in-clause provenance marker. It succeeds only for a key this
% module declares, so a clause cannot claim a provision that has no record.
implements(Key) :-
    citation(Key, _).

citation(british_nationality_act_1981_section_1_1, [
    label-'British Nationality Act 1981, s. 1(1)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'A person born in the United Kingdom after commencement shall be a British citizen if at the time of the birth his father or mother is—',
    units-['ukpga-1981-61#section-1-1', 'ukpga-1981-61#section-1-1-a', 'ukpga-1981-61#section-1-1-b']
]).

citation(british_nationality_act_1981_section_1_2, [
    label-'British Nationality Act 1981, s. 1(2)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'A new-born infant who, after commencement, is found abandoned in the United Kingdom shall, unless the contrary is shown, be deemed for the purposes of subsection (1)—',
    units-['ukpga-1981-61#section-1-2', 'ukpga-1981-61#section-1-2-a', 'ukpga-1981-61#section-1-2-b']
]).

citation(british_nationality_act_1981_section_1_3, [
    label-'British Nationality Act 1981, s. 1(3)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'A person born in the United Kingdom after commencement who is not a British citizen by virtue of subsection (1) or (2) shall be entitled to be registered as a British citizen if, while he is a minor—',
    units-['ukpga-1981-61#section-1-3', 'ukpga-1981-61#section-1-3-a', 'ukpga-1981-61#section-1-3-b']
]).

citation(british_nationality_act_1981_section_1_4, [
    label-'British Nationality Act 1981, s. 1(4)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'A person born in the United Kingdom after commencement who is not a British citizen by virtue of subsection (1) or (2) shall be entitled, on an application for his registration as a British citizen made at any time after he has attained the age of ten years, to be registered as such a citizen if, as regards each of the first ten years of that person\'s life, the number of days on which he was absent from the United Kingdom in that year does not exceed 90.',
    units-['ukpga-1981-61#section-1-4']
]).

citation(british_nationality_act_1981_section_1_5, [
    label-'British Nationality Act 1981, s. 1(5)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'Where after commencement an order authorising the adoption of a minor who is not a British citizen is made by any court in the United Kingdom, he shall be a British citizen as from the date on which the order is made if the adopter or, in the case of a joint adoption, one of the adopters is a British citizen on that date.',
    units-['ukpga-1981-61#section-1-5']
]).

citation(british_nationality_act_1981_section_1_6, [
    label-'British Nationality Act 1981, s. 1(6)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'Where an order in consequence of which any person became a British citizen by virtue of subsection (5) ceases to have effect, whether on annulment or otherwise, the cesser shall not affect the status of that person as a British citizen.',
    units-['ukpga-1981-61#section-1-6']
]).

citation(british_nationality_act_1981_section_1_7, [
    label-'British Nationality Act 1981, s. 1(7)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'If in the special circumstances of any particular case the Secretary of State thinks fit, he may for the purposes of subsection (4) treat the person to whom the application relates as fulfilling the requirement specified in that subsection although, as regards any one or more of the first ten years of that person\'s life, the number of days on which he was absent from the United Kingdom in that year or each of the years in question exceeds 90.',
    units-['ukpga-1981-61#section-1-7']
]).

citation(british_nationality_act_1981_section_2_1_a, [
    label-'British Nationality Act 1981, s. 2(1)(a)',
    ref-'https://www.legislation.gov.uk/ukpga/1981/61/enacted',
    verbatim-'is a British citizen otherwise than by descent; or',
    units-['ukpga-1981-61#section-2-1-a', 'ukpga-1981-61#section-2-1']
