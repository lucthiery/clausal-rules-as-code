% test_kernel.clausal -- the calendar and period arithmetic of kernel.clausal.
:- module(test_kernel, []).
:- use_module(library(clpz)).
:- use_module(uk/british_nationality_act_1981/kernel, [
    commencement_day_number/1, date_day_number/2, day_number_date/2, valid_date_t/2,
    years_after/3, period_of_years_ending_with/4, days_in_periods_within/4,
    day_in_any_period_t/3, attained_age_t/4, minor_t/3, leap_year_t/2]).

test('day 0 is 1 January 1970') :- date_day_number(date(1970, 1, 1), 0).
test('commencement is day 4748') :- commencement_day_number(4748).
test('day numbers round trip across a leap day') :-
    date_day_number(date(2024, 2, 29), N), day_number_date(N, date(2024, 2, 29)),
    M #= N + 1, day_number_date(M, date(2024, 3, 1)).
test('round trip 31 December 1899') :-
    date_day_number(date(1899, 12, 31), N), day_number_date(N, D), D == date(1899, 12, 31).
test('2000 is a leap year, 1900 is not') :- leap_year_t(2000, true), leap_year_t(1900, false).
test('30 February does not exist') :- valid_date_t(date(2024, 2, 30), false).
test('29 February 2023 does not exist') :- valid_date_t(date(2023, 2, 29), false).
test('month 13 does not exist') :- valid_date_t(date(2023, 13, 1), false).
test('a 29 February birthday falls on 1 March in a common year') :-
    years_after(date(2004, 2, 29), 1, date(2005, 3, 1)).
test('five years ending with 15 June 2024 begin on 16 June 2019') :-
    period_of_years_ending_with(date(2024, 6, 15), 5, S, E),
    day_number_date(S, date(2019, 6, 16)), day_number_date(E, date(2024, 6, 15)).
% Home Office, "Naturalisation as a British citizen by discretion" v16.0 (11 November 2025):
% "an application under section 6(1) made on 1 September 2022, the applicant must have been
% legally in the UK on 2 September 2017."
test('Home Office worked example: five years ending with 1 September 2022 begin on 2 September 2017') :-
    period_of_years_ending_with(date(2022, 9, 1), 5, S, _),
    day_number_date(S, date(2017, 9, 2)).
test('three years ending with 29 February 2024 begin on 1 March 2021') :-
    period_of_years_ending_with(date(2024, 2, 29), 3, S, _),
    day_number_date(S, date(2021, 3, 1)).
test('absence days are clipped to the window, both ends included') :-
    date_day_number(date(2020, 1, 1), S), date_day_number(date(2020, 1, 31), E),
    days_in_periods_within([period(date(2019, 12, 25), date(2020, 1, 3)),
                            period(date(2020, 1, 31), date(2020, 2, 10))], S, E, Days),
    Days == 4.
test('an ongoing period contains every later day') :-
    date_day_number(date(2090, 1, 1), N),
    day_in_any_period_t([period(date(2000, 1, 1), ongoing)], N, true).
test('18th birthday: a minor the day before, not on the day') :-
    date_day_number(date(2018, 5, 9), Before), date_day_number(date(2018, 5, 10), On),
    minor_t(date(2000, 5, 10), Before, true), minor_t(date(2000, 5, 10), On, false).
test('born 29 February 2004 attains 18 on 1 March 2022') :-
    date_day_number(date(2022, 2, 28), Before), date_day_number(date(2022, 3, 1), On),
    attained_age_t(date(2004, 2, 29), 18, Before, false), attained_age_t(date(2004, 2, 29), 18, On, true).
test('DET minor_t') :-
    findall(T, minor_t(date(2000, 5, 10), 11000, T), L), length(L, 1).

:- end_module(test_kernel).
