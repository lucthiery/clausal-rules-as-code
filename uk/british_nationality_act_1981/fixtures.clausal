% =====================================================================
% fixtures.clausal -- named profiles for uk/british_nationality_act_1981.
% A TOP-LAYER consumer: it builds profiles and decides nothing.
%
% A profile is a dict built from Key-Value pairs with dict_pairs/2; a
% parent, adopter or spouse is a profile of the same shape. Each subject
% below says which provision it exercises and what the Act gives for it;
% the tests pin those answers.
% =====================================================================

:- module(fixtures, [
    british_nationality_subject/1,
    british_nationality_profile_for/2
]).

british_nationality_subject(Subject) :-
    subject_profile(Subject, _).

british_nationality_profile_for(Subject, Profile) :-
    subject_profile(Subject, Profile).

% ---- Parents and grandparents used by several subjects -------------------

% Born in the UK in 1955; became a British citizen otherwise than by descent
% at commencement (s. 11(1)).
citizen_from_commencement(Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1955, 3, 1),
        place_of_birth-united_kingdom,
        citizenship_at_commencement-otherwise_than_by_descent
    ]).

% Born abroad in 1955, never a British citizen, never in the UK.
foreign_national(Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1955, 6, 1),
        place_of_birth-outside_united_kingdom
    ]).

% A foreign national ordinarily resident in the UK from 1980 with no
% restriction on her stay: settled (s. 50(2)).
settled_foreign_national(Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1956, 6, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(1980, 1, 1), ongoing)]
    ]).

% A British citizen BY DESCENT: born abroad in 1960 to a father who was born
% in the UK; a citizen by descent at commencement (s. 14(1)(b), stated).
% He lived in the UK from 1978 to 1985 and abroad from 1 June 1985.
citizen_by_descent_father(Profile) :-
    citizen_from_commencement(Grandfather),
    dict_pairs(Profile, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1960, 2, 1), date(1977, 12, 31)),
                                      period(date(1985, 6, 1), date(2030, 12, 31))]
    ]).

% ---- s. 1(1): birth in the United Kingdom ------------------------------

subject_profile(born_in_united_kingdom_to_citizen_mother, Profile) :-
    citizen_from_commencement(Mother),
    foreign_national(Father),
    dict_pairs(Profile, [
        date_of_birth-date(1990, 5, 5),
        place_of_birth-united_kingdom,
        mother-Mother,
        father-Father
    ]).

% Commencement boundary: born on 1 January 1983 (after commencement, which is
% the beginning of that day, s. 53(2)) ...
subject_profile(born_on_commencement_day, Profile) :-
    citizen_from_commencement(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1983, 1, 1),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% ... and the day before: s. 1(1) does not apply; citizenship then turns on
% s. 11 (pre-1983 law), which this profile does not state.
subject_profile(born_day_before_commencement, Profile) :-
    citizen_from_commencement(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1982, 12, 31),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% The same person, with his s. 11 status stated: a citizen from commencement.
subject_profile(born_day_before_commencement_citizen_at_commencement, Profile) :-
    citizen_from_commencement(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1982, 12, 31),
        place_of_birth-united_kingdom,
        mother-Mother,
        citizenship_at_commencement-otherwise_than_by_descent
    ]).

% Father settled, mother a foreign national: a citizen through the father.
subject_profile(born_in_united_kingdom_to_settled_father, Profile) :-
    settled_foreign_national(Father),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1995, 7, 7),
        place_of_birth-united_kingdom,
        mother-Mother,
        father-Father
    ]).

% Illegitimacy (s. 50(9)(b)): the father is a British citizen but the
% child is born illegitimate, and the mother is neither a citizen nor
% settled. Not a citizen.
subject_profile(born_illegitimate_to_citizen_father, Profile) :-
    citizen_from_commencement(Father),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1990, 3, 3),
        place_of_birth-united_kingdom,
        mother-Mother,
        father-Father,
        born_legitimate-false
    ]).

% Legitimation (s. 47(1)): the same child, legitimated by the parents'
% marriage on 1 June 2000: a citizen under s. 1(1) from that date.
subject_profile(legitimated_by_marriage_in_2000, Profile) :-
    citizen_from_commencement(Father),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1990, 3, 3),
        place_of_birth-united_kingdom,
        mother-Mother,
        father-Father,
        born_legitimate-false,
        legitimated_on-date(2000, 6, 1)
    ]).

% Settled status: the mother is ordinarily resident but her leave is limited
% (a restriction on her stay): not settled, so the child is not a citizen.
subject_profile(born_to_mother_with_limited_leave, Profile) :-
    dict_pairs(Mother, [
        date_of_birth-date(1985, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2010, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2010, 1, 1), date(2016, 12, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2015, 4, 4),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% The same mother after her restriction ends: a later child is a citizen.
subject_profile(born_after_mother_restriction_ended, Profile) :-
    dict_pairs(Mother, [
        date_of_birth-date(1985, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2010, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2010, 1, 1), date(2016, 12, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2017, 4, 4),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% s. 50(5): a mother "ordinarily resident" without restriction, but in the
% UK in breach of the immigration laws at the birth: not ordinarily
% resident, so not settled.
subject_profile(born_to_mother_in_breach_of_immigration_laws, Profile) :-
    dict_pairs(Mother, [
        date_of_birth-date(1980, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2000, 1, 1), ongoing)],
        in_united_kingdom_in_breach_of_immigration_laws-[period(date(2003, 1, 1), date(2006, 1, 1))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2004, 8, 8),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% s. 50(3)(a): a diplomat's family (exemption under s. 8(3) of the
% Immigration Act 1971) is not settled.
subject_profile(born_to_exempt_diplomat, Profile) :-
    dict_pairs(Father, [
        date_of_birth-date(1970, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(1998, 1, 1), ongoing)],
        immigration_exemptions-[exemption(section_8_3, date(1998, 1, 1), ongoing)],
        diplomatic_immunity-[period(date(1998, 1, 1), ongoing)]
    ]),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(2001, 9, 9),
        place_of_birth-united_kingdom,
        mother-Mother,
        father-Father
    ]).

% s. 50(4): a mother settled from 1990, who in 1999 took up an employment
% that gave her an exemption under s. 8(3) without diplomatic immunity, and
% stayed ordinarily resident: regarded as settled for s. 1(1).
subject_profile(born_to_formerly_settled_exempt_mother, Profile) :-
    dict_pairs(Mother, [
        date_of_birth-date(1965, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(1990, 1, 1), ongoing)],
        immigration_exemptions-[exemption(section_8_3, date(1999, 1, 1), ongoing)]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2002, 2, 2),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% ... but not if the child's father has diplomatic immunity at the birth.
subject_profile(born_to_formerly_settled_exempt_mother_father_immune, Profile) :-
    dict_pairs(Mother, [
        date_of_birth-date(1965, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(1990, 1, 1), ongoing)],
        immigration_exemptions-[exemption(section_8_3, date(1999, 1, 1), ongoing)]
    ]),
    dict_pairs(Father, [
        date_of_birth-date(1963, 1, 1),
        place_of_birth-outside_united_kingdom,
        diplomatic_immunity-[period(date(1999, 1, 1), ongoing)]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2002, 2, 2),
        place_of_birth-united_kingdom,
        mother-Mother,
        father-Father
    ]).

% Three generations, the classic recursion: the grandmother became a
% citizen at commencement, the mother was born in the UK in 1985 (a citizen
% under s. 1(1) through her), and the child is born in the UK in 2010.
subject_profile(born_in_united_kingdom_third_generation, Profile) :-
    citizen_from_commencement(Grandmother),
    dict_pairs(Mother, [
        date_of_birth-date(1985, 10, 10),
        place_of_birth-united_kingdom,
        mother-Grandmother
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2010, 11, 11),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% ---- s. 1(2): found abandoned ---------------------------------------------

subject_profile(found_abandoned_new_born, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1991, 1, 20),
        place_of_birth-united_kingdom,
        found_abandoned_in_united_kingdom_on-date(1991, 1, 21)
    ]).

% "unless the contrary is shown": the parents were later traced, both
% foreign nationals passing through.
subject_profile(found_abandoned_contrary_shown, Profile) :-
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1991, 1, 20),
        place_of_birth-united_kingdom,
        mother-Mother,
        found_abandoned_in_united_kingdom_on-date(1991, 1, 21),
        contrary_shown_for_abandoned_infant-true
    ]).

% ---- s. 2(1): birth outside the United Kingdom --------------------------

% (a): a mother who is a citizen otherwise than by descent: a citizen BY
% DESCENT (s. 14(1)(a)).
subject_profile(born_abroad_to_citizen_mother, Profile) :-
    citizen_from_commencement(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1992, 2, 2),
        place_of_birth-outside_united_kingdom,
        mother-Mother
    ]).

% The second generation born abroad: the father is a citizen only by
% descent, so s. 2(1)(a) does not apply.
subject_profile(born_abroad_to_father_citizen_by_descent, Profile) :-
    citizen_by_descent_father(Father),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1998, 8, 1),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father
    ]).

% (b): the same father, but serving abroad in Crown service, recruited in
% the UK: a citizen otherwise than by descent.
subject_profile(born_abroad_to_crown_servant_father, Profile) :-
    citizen_from_commencement(Grandfather),
    dict_pairs(Father, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        service_outside_united_kingdom-[service(crown_service_under_the_government_of_the_united_kingdom,
            date(1995, 1, 1), date(2002, 1, 1), united_kingdom)]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(1998, 8, 1),
        place_of_birth-outside_united_kingdom,
        father-Father
    ]).

% (b) near miss: recruited abroad, so (b) does not apply.
subject_profile(born_abroad_to_crown_servant_recruited_abroad, Profile) :-
    citizen_from_commencement(Grandfather),
    dict_pairs(Father, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        service_outside_united_kingdom-[service(crown_service_under_the_government_of_the_united_kingdom,
            date(1995, 1, 1), date(2002, 1, 1), other_country)]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(1998, 8, 1),
        place_of_birth-outside_united_kingdom,
        father-Father
    ]).

% (c): a mother by descent, serving in a Community institution, recruited
% in a member state.
subject_profile(born_abroad_to_community_servant_mother, Profile) :-
    citizen_from_commencement(Grandmother),
    dict_pairs(Mother, [
        date_of_birth-date(1962, 4, 4),
        place_of_birth-outside_united_kingdom,
        mother-Grandmother,
        citizenship_at_commencement-by_descent,
        service_outside_united_kingdom-[service(community_institution,
            date(1990, 1, 1), ongoing, member_state_of_the_communities)]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(1999, 9, 9),
        place_of_birth-outside_united_kingdom,
        mother-Mother
    ]).

% ---- s. 1(5): adoption ------------------------------------------------------

subject_profile(adopted_by_citizen_in_united_kingdom_court, Profile) :-
    citizen_from_commencement(Adopter),
    dict_pairs(Profile, [
        date_of_birth-date(2005, 5, 5),
        place_of_birth-outside_united_kingdom,
        adoption_orders-[adoption_order(date(2008, 3, 3), court_in_united_kingdom, [Adopter])]
    ]).

subject_profile(adopted_by_citizen_in_foreign_court, Profile) :-
    citizen_from_commencement(Adopter),
    dict_pairs(Profile, [
        date_of_birth-date(2005, 5, 5),
        place_of_birth-outside_united_kingdom,
        adoption_orders-[adoption_order(date(2008, 3, 3), court_outside_united_kingdom, [Adopter])]
    ]).

% A joint adoption: one adopter a citizen is enough.
subject_profile(adopted_jointly_one_adopter_citizen, Profile) :-
    citizen_from_commencement(Adopter),
    foreign_national(OtherAdopter),
    dict_pairs(Profile, [
        date_of_birth-date(2005, 5, 5),
        place_of_birth-outside_united_kingdom,
        adoption_orders-[adoption_order(date(2008, 3, 3), court_in_united_kingdom, [OtherAdopter, Adopter])]
    ]).

% An adult is not "a minor": no citizenship by the order.
subject_profile(adopted_as_adult, Profile) :-
    citizen_from_commencement(Adopter),
    dict_pairs(Profile, [
        date_of_birth-date(1985, 5, 5),
        place_of_birth-outside_united_kingdom,
        adoption_orders-[adoption_order(date(2004, 3, 3), court_in_united_kingdom, [Adopter])]
    ]).

% ---- Registration and naturalisation as facts ---------------------------

subject_profile(registered_under_section_3_2, Profile) :-
    citizen_by_descent_father(Father),
    dict_pairs(Profile, [
        date_of_birth-date(1998, 8, 1),
        place_of_birth-outside_united_kingdom,
        father-Father,
        registrations-[registration(section_3_2, date(1999, 2, 1))]
    ]).

subject_profile(naturalised_in_2010, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1975, 1, 1),
        place_of_birth-outside_united_kingdom,
        naturalisations-[naturalisation(section_6_1, date(2010, 6, 30))]
    ]).

% ---- Registration entitlements ------------------------------------------

% s. 1(3): born in the UK in 2000 to foreign nationals; the mother becomes
% settled in 2005.
subject_profile(section_1_3_mother_settles_later, Profile) :-
    dict_pairs(Mother, [
        date_of_birth-date(1975, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(1998, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(1998, 1, 1), date(2005, 3, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 6, 15),
        place_of_birth-united_kingdom,
        mother-Mother
    ]).

% s. 1(4): born in the UK in 2000, never registered; absences of 30 days a
% year; in 2004 a long absence of 120 days.
subject_profile(section_1_4_ten_years_in_united_kingdom, Profile) :-
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 6, 15),
        place_of_birth-united_kingdom,
        mother-Mother,
        absences_from_united_kingdom-[period(date(2003, 7, 1), date(2003, 7, 30))]
    ]).

subject_profile(section_1_4_long_absence_in_year_five, Profile) :-
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 6, 15),
        place_of_birth-united_kingdom,
        mother-Mother,
        absences_from_united_kingdom-[period(date(2004, 7, 1), date(2004, 10, 28))]
    ]).

% s. 3(2): born abroad in 2000 to a father who is a citizen by descent, and
% whose own father was a citizen otherwise than by descent; the father lived
% in the UK from 1978 to 1985, three years and more before the birth.
subject_profile(section_3_2_born_abroad_to_father_by_descent, Profile) :-
    citizen_by_descent_father(Father),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 3, 10),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father
    ]).

% The same, but the father never lived in the UK: s. 3(3)(c) fails ...
subject_profile(section_3_2_father_never_resident, Profile) :-
    citizen_from_commencement(Grandfather),
    dict_pairs(Father, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1960, 2, 1), date(2040, 1, 1))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 3, 10),
        place_of_birth-outside_united_kingdom,
        father-Father
    ]).

% ... unless the child is born stateless (s. 3(2): (a) and (b) only).
subject_profile(section_3_2_father_never_resident_child_stateless, Profile) :-
    citizen_from_commencement(Grandfather),
    dict_pairs(Father, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1960, 2, 1), date(2040, 1, 1))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 3, 10),
        place_of_birth-outside_united_kingdom,
        father-Father,
        born_stateless-true
    ]).

% s. 3(5): born abroad in 2005 to a mother who is a citizen by descent; the
% family has lived in the UK since 2010; both parents consent.
subject_profile(section_3_5_family_resident, Profile) :-
    citizen_from_commencement(Grandmother),
    dict_pairs(Mother, [
        date_of_birth-date(1975, 4, 4),
        place_of_birth-outside_united_kingdom,
        mother-Grandmother,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1975, 4, 4), date(2009, 12, 31))]
    ]),
    dict_pairs(Father, [
        date_of_birth-date(1973, 3, 3),
        place_of_birth-outside_united_kingdom,
        absences_from_united_kingdom-[period(date(1973, 3, 3), date(2009, 12, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2005, 1, 1),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father,
        absences_from_united_kingdom-[period(date(2005, 1, 1), date(2009, 12, 31))],
        consent_to_registration_signified_by-[mother, father]
    ]).

% The same family, but the father stayed abroad until 2013.
subject_profile(section_3_5_father_abroad, Profile) :-
    citizen_from_commencement(Grandmother),
    dict_pairs(Mother, [
        date_of_birth-date(1975, 4, 4),
        place_of_birth-outside_united_kingdom,
        mother-Grandmother,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1975, 4, 4), date(2009, 12, 31))]
    ]),
    dict_pairs(Father, [
        date_of_birth-date(1973, 3, 3),
        place_of_birth-outside_united_kingdom,
        absences_from_united_kingdom-[period(date(1973, 3, 3), date(2012, 12, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2005, 1, 1),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father,
        absences_from_united_kingdom-[period(date(2005, 1, 1), date(2009, 12, 31))],
        consent_to_registration_signified_by-[mother, father]
    ]).

% ... and the same again, but the father abroad has died (s. 3(6)(a), (b)):
% the mother's residence and consent suffice.
subject_profile(section_3_5_father_abroad_died, Profile) :-
    citizen_from_commencement(Grandmother),
    dict_pairs(Mother, [
        date_of_birth-date(1975, 4, 4),
        place_of_birth-outside_united_kingdom,
        mother-Grandmother,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1975, 4, 4), date(2009, 12, 31))]
    ]),
    dict_pairs(Father, [
        date_of_birth-date(1973, 3, 3),
        place_of_birth-outside_united_kingdom,
        absences_from_united_kingdom-[period(date(1973, 3, 3), date(2012, 12, 31))],
        date_of_death-date(2011, 5, 5)
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2005, 1, 1),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father,
        absences_from_united_kingdom-[period(date(2005, 1, 1), date(2009, 12, 31))],
        consent_to_registration_signified_by-[mother]
    ]).

% s. 4(2): a British Overseas citizen in the UK since 2005, settled.
subject_profile(section_4_british_overseas_citizen_resident, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1970, 7, 7),
        place_of_birth-outside_united_kingdom,
        british_nationality_other_than_citizenship-british_overseas_citizen,
        ordinarily_resident_in_united_kingdom-[period(date(2005, 1, 1), ongoing)],
        absences_from_united_kingdom-[period(date(1970, 7, 7), date(2004, 12, 31)),
                                      period(date(2012, 8, 1), date(2012, 8, 21))]
    ]).

% The same, with 100 days abroad in the last twelve months (s. 4(4)(a)).
subject_profile(section_4_british_overseas_citizen_long_absence, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1970, 7, 7),
        place_of_birth-outside_united_kingdom,
        british_nationality_other_than_citizenship-british_overseas_citizen,
        ordinarily_resident_in_united_kingdom-[period(date(2005, 1, 1), ongoing)],
        absences_from_united_kingdom-[period(date(1970, 7, 7), date(2004, 12, 31)),
                                      period(date(2014, 9, 1), date(2014, 12, 9))]
    ]).

% The same, still on limited leave on the date of the application.
subject_profile(section_4_british_overseas_citizen_restricted, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1970, 7, 7),
        place_of_birth-outside_united_kingdom,
        british_nationality_other_than_citizenship-british_overseas_citizen,
        ordinarily_resident_in_united_kingdom-[period(date(2005, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2005, 1, 1), date(2016, 12, 31))],
        absences_from_united_kingdom-[period(date(1970, 7, 7), date(2004, 12, 31))]
    ]).

% A foreign national with the same history: s. 4 does not apply to him.
subject_profile(section_4_foreign_national_resident, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1970, 7, 7),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2005, 1, 1), ongoing)],
        absences_from_united_kingdom-[period(date(1970, 7, 7), date(2004, 12, 31))]
    ]).

% ---- Naturalisation -------------------------------------------------------

subject_profile(naturalisation_resident_five_years, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1980, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2008, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2008, 1, 1), date(2012, 12, 31))],
        absences_from_united_kingdom-[period(date(1980, 1, 1), date(2007, 12, 31)),
                                      period(date(2014, 8, 1), date(2014, 8, 31))],
        good_character-true,
        sufficient_knowledge_of_language-true,
        intention_after_naturalisation-principal_home_in_united_kingdom
    ]).

% 500 days abroad in the five years: Schedule 1 para 2(a) may overlook it.
subject_profile(naturalisation_too_many_absences, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1980, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2008, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2008, 1, 1), date(2012, 12, 31))],
        absences_from_united_kingdom-[period(date(1980, 1, 1), date(2007, 12, 31)),
                                      period(date(2011, 1, 1), date(2012, 5, 14))],
        good_character-true,
        sufficient_knowledge_of_language-true,
        intention_after_naturalisation-principal_home_in_united_kingdom
    ]).

subject_profile(naturalisation_not_of_good_character, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1980, 1, 1),
        place_of_birth-outside_united_kingdom,
        ordinarily_resident_in_united_kingdom-[period(date(2008, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2008, 1, 1), date(2012, 12, 31))],
        absences_from_united_kingdom-[period(date(1980, 1, 1), date(2007, 12, 31))],
        good_character-false,
        sufficient_knowledge_of_language-true,
        intention_after_naturalisation-principal_home_in_united_kingdom
    ]).

% s. 6(2): married to a British citizen, three years in the UK.
subject_profile(naturalisation_spouse_of_citizen, Profile) :-
    citizen_from_commencement(Spouse),
    dict_pairs(Profile, [
        date_of_birth-date(1982, 1, 1),
        place_of_birth-outside_united_kingdom,
        spouse-Spouse,
        ordinarily_resident_in_united_kingdom-[period(date(2011, 1, 1), ongoing)],
        immigration_restrictions_on_stay-[period(date(2011, 1, 1), date(2013, 12, 31))],
        absences_from_united_kingdom-[period(date(1982, 1, 1), date(2010, 12, 31))],
        good_character-true,
        sufficient_knowledge_of_language-false,
        intention_after_naturalisation-other
    ]).

% s. 6(2) with the spouse serving abroad in Crown service, recruited in the
% UK, and the applicant abroad with the spouse: para 4(d) lets the residence
% requirements of para 3(a) and (b) be waived.
subject_profile(naturalisation_spouse_of_crown_servant_abroad, Profile) :-
    dict_pairs(Spouse, [
        date_of_birth-date(1975, 1, 1),
        place_of_birth-united_kingdom,
        citizenship_at_commencement-otherwise_than_by_descent,
        service_outside_united_kingdom-[service(crown_service_under_the_government_of_the_united_kingdom,
            date(2010, 1, 1), ongoing, united_kingdom)]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(1982, 1, 1),
        place_of_birth-outside_united_kingdom,
        spouse-Spouse,
        absences_from_united_kingdom-[period(date(1982, 1, 1), date(2030, 12, 31))],
        good_character-true,
        sufficient_knowledge_of_language-true,
        intention_after_naturalisation-other
    ]).

% ---- Classic edge cases (added 2026-10-25) ------------------------------

% s. 3(3)(b)(ii), the counterfactual: the grandfather died in 1980, before
% commencement, but would have become a citizen otherwise than by descent at
% commencement "but for his death".
subject_profile(section_3_2_grandfather_died_before_commencement, Profile) :-
    dict_pairs(Grandfather, [
        date_of_birth-date(1930, 1, 1),
        place_of_birth-united_kingdom,
        date_of_death-date(1980, 1, 1),
        citizenship_at_commencement-would_have_become_but_for_death(otherwise_than_by_descent)
    ]),
    dict_pairs(Father, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1960, 2, 1), date(1977, 12, 31)),
                                      period(date(1985, 6, 1), date(2030, 12, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 3, 10),
        place_of_birth-outside_united_kingdom,
        father-Father
    ]).

% ... near miss: the grandfather would only have become a citizen BY DESCENT.
subject_profile(section_3_2_grandfather_died_would_have_been_by_descent, Profile) :-
    dict_pairs(Grandfather, [
        date_of_birth-date(1930, 1, 1),
        place_of_birth-outside_united_kingdom,
        date_of_death-date(1980, 1, 1),
        citizenship_at_commencement-would_have_become_but_for_death(by_descent)
    ]),
    dict_pairs(Father, [
        date_of_birth-date(1960, 2, 1),
        place_of_birth-outside_united_kingdom,
        father-Grandfather,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1960, 2, 1), date(1977, 12, 31)),
                                      period(date(1985, 6, 1), date(2030, 12, 31))]
    ]),
    dict_pairs(Profile, [
        date_of_birth-date(2000, 3, 10),
        place_of_birth-outside_united_kingdom,
        father-Father
    ]).

% s. 3(2) through the MOTHER: she is a citizen by descent, her own mother a
% citizen otherwise than by descent, and she lived in the UK 1990-1995; the
% father is a foreign national.
subject_profile(section_3_2_through_mother, Profile) :-
    citizen_from_commencement(Grandmother),
    dict_pairs(Mother, [
        date_of_birth-date(1970, 5, 5),
        place_of_birth-outside_united_kingdom,
        mother-Grandmother,
        citizenship_at_commencement-by_descent,
        absences_from_united_kingdom-[period(date(1970, 5, 5), date(1989, 12, 31)),
                                      period(date(1996, 1, 1), date(2030, 12, 31))]
    ]),
    foreign_national(Father),
    dict_pairs(Profile, [
        date_of_birth-date(2001, 1, 15),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father
    ]).

% s. 1(2): "a new-born infant who, after commencement, is found abandoned" --
% the finding, not the birth, must be after commencement; the infant is then
% deemed born in the UK after commencement.
subject_profile(found_abandoned_just_after_commencement, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1982, 12, 30),
        place_of_birth-united_kingdom,
        found_abandoned_in_united_kingdom_on-date(1983, 1, 2)
    ]).

% ... and found before commencement: s. 1(2) does not apply.
subject_profile(found_abandoned_before_commencement, Profile) :-
    dict_pairs(Profile, [
        date_of_birth-date(1982, 12, 20),
        place_of_birth-united_kingdom,
        found_abandoned_in_united_kingdom_on-date(1982, 12, 21)
    ]).

% s. 1(5): an adoption order made before commencement does not confer
% citizenship under the Act.
subject_profile(adopted_before_commencement, Profile) :-
    citizen_from_commencement(Adopter),
    dict_pairs(Profile, [
        date_of_birth-date(1980, 5, 5),
        place_of_birth-outside_united_kingdom,
        adoption_orders-[adoption_order(date(1982, 6, 1), court_in_united_kingdom, [Adopter])]
    ]).

% s. 2(1)(a) with s. 47(1): born abroad in 1990 to an unmarried father who is
% a citizen otherwise than by descent; the parents marry on 1 March 1995.
subject_profile(born_abroad_legitimated_in_1995, Profile) :-
    citizen_from_commencement(Father),
    foreign_national(Mother),
    dict_pairs(Profile, [
        date_of_birth-date(1990, 3, 3),
        place_of_birth-outside_united_kingdom,
        mother-Mother,
        father-Father,
        born_legitimate-false,
        legitimated_on-date(1995, 3, 1)
    ]).

:- end_module(fixtures).
